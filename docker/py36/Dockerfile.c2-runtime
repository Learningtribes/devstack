# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM --platform=$TARGETPLATFORM ${BASE_IMAGE}

ARG PLATFORM_COMMIT
ARG PLATFORM_TREE
ARG DEVSTACK_BUILD_COMMIT
ARG DEVSTACK_BUILD_TREE
ARG ORA2_COMMIT=d3f24a9c539528e960c8dcc9aef200cea0c49baf
ARG SUBMISSIONS_PATCH_SHA256=00b289b42748b93e314fbb8cf90117778ceadac4789f7ec234fc9ef554b31acf

LABEL c2.runtime.platform.commit="${PLATFORM_COMMIT}"
LABEL c2.runtime.platform.tree="${PLATFORM_TREE}"
LABEL c2.runtime.devstack.commit="${DEVSTACK_BUILD_COMMIT}"
LABEL c2.runtime.devstack.tree="${DEVSTACK_BUILD_TREE}"
LABEL c2.runtime.ora2.commit="${ORA2_COMMIT}"
LABEL c2.runtime.submissions_patch.sha256="${SUBMISSIONS_PATCH_SHA256}"
LABEL c2.runtime.submissions.api.sha256="a30b76f9f7676c73b57f8a696c6eb1fc101ae4a6cabf80680cc8f1e5380dd319"
LABEL c2.runtime.submissions.models.sha256="0b89c4191af3c9aaeaf41376c3dd44ad194841e95adee964360eb1a79cb68de3"

COPY edx-submissions-2.1.1-py3.patch /opt/py36-c2/edx-submissions-2.1.1-py3.patch

RUN pip install --no-cache-dir --no-deps --force-reinstall \
        "git+https://github.com/Learningtribes/edx-ora2@${ORA2_COMMIT}#egg=ora2" \
    && python -c "import glob, json, pkg_resources; dist = pkg_resources.get_distribution('ora2'); paths = glob.glob(dist.location + '/ora2-*.dist-info/direct_url.json'); assert dist.version == '2.1.17'; assert len(paths) == 1; direct_url = json.load(open(paths[0])); assert direct_url['vcs_info']['commit_id'] == '${ORA2_COMMIT}'; print('ORA2 source OK', direct_url)" \
    && cd /usr/local/lib/python3.6/site-packages \
    && echo "7eed5f98f9db1ef05de9ad5706a6abc5f8c75134a131dcedd8438f1116b0c3d4  submissions/api.py" | sha256sum -c - \
    && echo "484e83e31be3a44b084e8c2a976baf48620129ddd18467f805a7280e34fb1c75  submissions/models.py" | sha256sum -c - \
    && git apply --unidiff-zero --check /opt/py36-c2/edx-submissions-2.1.1-py3.patch \
    && git apply --unidiff-zero /opt/py36-c2/edx-submissions-2.1.1-py3.patch \
    && echo "a30b76f9f7676c73b57f8a696c6eb1fc101ae4a6cabf80680cc8f1e5380dd319  submissions/api.py" | sha256sum -c - \
    && echo "0b89c4191af3c9aaeaf41376c3dd44ad194841e95adee964360eb1a79cb68de3  submissions/models.py" | sha256sum -c - \
    && cd / \
    && python -m compileall -q \
        /usr/local/lib/python3.6/site-packages/submissions/api.py \
        /usr/local/lib/python3.6/site-packages/submissions/models.py \
    && python -c "import pkg_resources; assert pkg_resources.get_distribution('edx-submissions').version == '2.1.1'" \
    && ! grep -E 'basestring|unicode\(' \
        /usr/local/lib/python3.6/site-packages/submissions/api.py \
        /usr/local/lib/python3.6/site-packages/submissions/models.py \
    && pip check

CMD ["python3"]
