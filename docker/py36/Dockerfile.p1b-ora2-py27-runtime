FROM ltdps/edxapp@sha256:cbeaca65ae3b7ec1a10d2438088d442af9fdedabf392b12a308f53c2acfa55cb

LABEL description="Open edX Hawthorn Python 2.7 R1 ORA2 runtime"
LABEL base_runtime="ltdps/edxapp@sha256:cbeaca65ae3b7ec1a10d2438088d442af9fdedabf392b12a308f53c2acfa55cb"
LABEL ora2_source_commit="d3f24a9c539528e960c8dcc9aef200cea0c49baf"

RUN cd /edx/app/edxapp/venvs/edxapp/src/edx-ora2 \
    && test -z "$(git status --short)" \
    && git fetch --depth=1 origin d3f24a9c539528e960c8dcc9aef200cea0c49baf \
    && git checkout --detach d3f24a9c539528e960c8dcc9aef200cea0c49baf \
    && test "$(git rev-parse HEAD)" = "d3f24a9c539528e960c8dcc9aef200cea0c49baf" \
    && test "$(git rev-parse HEAD^{tree})" = "faf7e4ad4dbaf1d9c8c103e468943a94d4d1f988" \
    && /edx/app/edxapp/venvs/edxapp/bin/pip install --no-cache-dir --no-deps -e . \
    && /edx/app/edxapp/venvs/edxapp/bin/python -m compileall -q openassessment \
    && /edx/app/edxapp/venvs/edxapp/bin/python -c "import os, pkg_resources, openassessment; dist = pkg_resources.get_distribution('ora2'); assert dist.version == '2.1.17'; assert os.path.realpath(openassessment.__file__).startswith('/edx/app/edxapp/venvs/edxapp/src/edx-ora2/'); print('ORA2 source OK', os.path.realpath(openassessment.__file__))" \
    && { PIP_DISABLE_PIP_VERSION_CHECK=1 /edx/app/edxapp/venvs/edxapp/bin/pip check > /tmp/p1b-ora2-py27-runtime-pip-check.txt 2>&1; test "$?" -eq 1; } \
    && sort /tmp/p1b-ora2-py27-runtime-pip-check.txt > /tmp/p1b-ora2-py27-runtime-pip-check.sorted \
    && printf '%s\n' \
        'fs-s3fs 0.1.9 has requirement fs~=2.0.18, but you have fs 2.4.16.' \
        'slackclient 1.3.2 has requirement requests<3.0a0,>=2.11, but you have requests 2.9.1.' \
        | sort | diff -u - /tmp/p1b-ora2-py27-runtime-pip-check.sorted
