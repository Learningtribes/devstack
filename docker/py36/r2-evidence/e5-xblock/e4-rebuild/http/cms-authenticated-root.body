  <script type="text/template" id="course_item-tpl">
      <a class="course-link courses_title" href="<%- url %>">
  <h3 class="course-title course-item-text truncated_string" id="" title="<%- content.display_name %>"><%- content.display_name %></h3>
  <span class="course_code">
      <%- number %><% if (run) { %>+<%- run %><% } %>
  </span>
</a>

<div class="course_creator">
   <%- creator %>
</div>
<% if (archived) { %>
  <span class="course_status">
    <span class="archive-flag"><%- gettext('Archived') %></span>
  </span>
<% } else { %>
  <% if (course_status === "released") { %>
    <span class="course_status">
      <ds-tag color="success" size="small"><%- gettext('Released') %></ds-tag>
    </span>
  <% } else if (course_status === "running") { %>
    <span class="course_status">
      <ds-tag color="info" size="small"><%- gettext('Running') %></ds-tag>
    </span>
  <% } else { %>
    <span class="course_status">
      <ds-tag color="caution" size="small"><%- gettext('Draft') %></ds-tag>
    </span>
  <% } %> 
<% } %>

<div class="course_created">
    <%- created %>
</div>
<div class="course_modified">
    <%- modified %>
</div>

<% if (lms_link && rerun_link) { %>
  <div class="course-actions course_pin">
    <% if (is_pinned) { %>
        <div class="course-pin-button pinned-hover-status" data-course_id="<%- id %>">
            <i class="fa-solid fa-thumbtack"></i>
        </div>
    <% } else { %>
        <div class="course-pin-button unpinned-hover-status" data-course_id="<%- id %>">
            <i class="fa-regular fa-thumbtack"></i>
        </div>
    <% } %>

  </div>

<% } %>

  </script>
  <script type="text/template" id="filter_bar-tpl">
      <div class="filters-inner">
    <ul class="active-filters facet-list"></ul>
</div>

  </script>
  <script type="text/template" id="filter-tpl">
        <button data-value="<%- query %>" class="facet-option discovery-button" data-type="<%- type %>">
    <span class="query"><%- gettext(name) %></span>
    <span aria-hidden="true" class="fa fa-times" aria-hidden="true"></span>
  </button>

  </script>
  <script type="text/template" id="facet-tpl">
      <div class="fact-wrapper hidden-panel">
    <h3 class="header-facet" title="<%- gettext(title) %>">
        <%- gettext(displayName) %>
    </h3>
    <ul data-facet="<%- name %>" class="facet-list collapse">
        <%= HtmlUtils.ensureHtml(optionsHtml) %>
    </ul>
</div>

  </script>
  <script type="text/template" id="facet_option-tpl">
      <li>
    <% if ( term.startsWith('---') ) { %>
        <button data-facet="<%- facet %>" data-value="<%- term %>" data-text="<%- name %>" class="facet-option discovery-button <%- selected ? 'selected' : '' %>">
            (<%- gettext('Empty') %>)
            <span class="count">
                <span class="count-number"><%- count %></span>
            </span>
        </button>
    <% } else { %>
        <button data-facet="<%- facet %>" data-value="<%- term %>" data-text="<%- name %>" class="facet-option discovery-button <%- selected ? 'selected' : '' %>">
            <%- gettext(name) %>
            <span class="count">
                <span class="count-number"><%- count %></span>
            </span>
        </button>
    <% } %>
</li>

  </script>

  
