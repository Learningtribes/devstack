<link rel="stylesheet" type="text/css" href="/static/studio/js/vendor/timepicker/jquery.timepicker.css" />
  <script type="text/template" id="catalog-visibility-editor-tpl">
    <div class="pacing-wrapper">
    <span class="msg"><%= gettext("Course Visibility in Catalog") %><span class="mandatory">*</span></span>
    <ol class="list-input pacing">
        <li class="field">
            <span class="icon fa-duotone fa-lock"></span>
            <label id="private-label" class="course-pace-label" for="private"><%= gettext("Private") %></label>
            <span class="tip"><%= gettext("The course will only be visible to Learners who have been enrolled.") %></span>
            <label>
                <input type="radio" class="ds-radio" name="catalog-visibility" id="private" value="none" aria-labelledby="private-label" />
            </label>
        </li>
        <li class="field">
            <span class="icon fa-duotone fa-link"></span>
            <label id="accessible-by-url-label" class="course-pace-label" for="accessible-by-url"><%= gettext("Accessible by URL") %></label>
            <span class="tip"><%= gettext("The course is accessible to Learners using the course link.") %></span>
            <label>
                <input type="radio" class="ds-radio" name="catalog-visibility" id="accessible-by-url" value="about" aria-labelledby="accessible-by-url-label" />
            </label>
        </li>
        <li class="field">
            <span class="icon fa-duotone fa-eye"></span>
            <label id="full-public-label" class="course-pace-label" for="full-public"><%= gettext("Public") %></label>
            <span class="tip"><%= gettext("The course is visible in the Catalog.") %></span>
            <label>
                <input type="radio" class="ds-radio" name="catalog-visibility" id="full-public" value="both" aria-labelledby="full-public-label" />
            </label>
        </li>
    </ol>
</div>

  </script>
  <script type="text/template" id="course-start-date-time-editor-tpl">
    <ol class="list-input">
    <li class="field-group field-group-course-start" id="course-start">
        <div class="field date" id="field-course_start_date">
            <label for="course_start_date" class="ds-input">
                <span><%= gettext("Start Date & Time") %><span class="mandatory">*</span></span>
                <input type="text" id="course_start_date" name="course_start_date"
                value="" placeholder="MM/DD/YYYY" class="start-date date start" autocomplete="off">
            </label>
        </div>
        <div class="field time" id="field-course-start-time">
            <span><%= pgettext('datetime-format', 'at') %></span>
            <label class="ds-input">
                <input type="text" class="time start timepicker ui-timepicker-input" id="course-start-time" value="" placeholder="00:00 (UTC)" autocomplete="off">
            </label>
        </div>
    </li>
</ol>
  </script>
  <script type="text/template" id="course-end-date-time-editor-tpl">
    <ol class="list-input">
    <li class="field-group field-group-course-end" id="course-end">
        <div class="field date" id="field-course-end-date">
            <label for="course_end_date" class="ds-input">
                <span><%= gettext("End Date & Time (Optional)") %></span>
                <input type="text" id="course_end_date" name="course_end_date"
                value="" placeholder="MM/DD/YYYY" class="end-date date end" autocomplete="off" >
            </label>
        </div>
        <div class="field time" id="field-course-end-time">
            <span><%= pgettext('datetime-format', 'at') %></span>
            <label class="ds-input">
                <input type="text" class="time end timepicker ui-timepicker-input" id="course-end-time" value="" placeholder="00:00 (UTC)" autocomplete="off">
            </label>
        </div>
    </li>
</ol>

  </script>
  <script type="text/template" id="course-description-editor-tpl">
    <ol class="list-input">
    <li class="field-group" id="field-course-description">
        <label class="ds-input" for="course-description"><%= gettext("Course Description (Optional)") %></label>
        <textarea class="text tinymce-editor" id="course-description-in-modal"></textarea>
    </li>
</ol>

  </script>
  <script type="text/template" id="course-privilege-flags-editor-tpl">
    <ol class="list-input">
    <li class="field-group">
        <div class="field">
            <ds-dropdown class="new-course-privileges-dropdown"
                        placeholder="<%= gettext('Select one or multiple Privilege Flags') %>"
                        multiple="true" searchable>
                <span slot="label">
                    <%= gettext("Privilege Flag(s)") %>
                    <% if (privilegeFlagsMandatory) { %>
                        <span class="mandatory">*</span>
                    <% } %>
                </span>
                <% _.each(privilegeFlags, function(privilege) { %>
                    <label class="<%= privilege.disabled ? 'hidden' : '' %>" key="<%= privilege.value %>">
                        <input type="checkbox"
                               value="<%= privilege.value %>"
                               class="ds-checkbox"/>
                        <span><%= privilege.text %></span>
                    </label>
                <% }); %>
            </ds-dropdown>
            <div id="review-selected-course-privilege-labels" class="review-selected-course-privilege-labels">
            </div>
        </div>
    </li>
</ol>

  </script>
  <script type="text/template" id="course-type-editor-tpl">
    <ol class="list-input">
    <li class="field-group">
        <div class="field">
            <label class="ds-input"><%= gettext("Course Type") %><span class="mandatory">*</span></label>
            <div class="course-type-container">
                <% _.each(courseTypes, function(name, id) { %>
                    <label>
                        <input class="ds-radio" type="radio" id="<%= id %>" name="course-type" value="<%= id %>" />
                        <%= gettext(name) %>
                    </label>
                <% }); %>
            </div>
        </div>
    </li>
</ol>

  </script>
  <script type="text/template" id="course-category-editor-tpl">
    <% if (!_.isEmpty(courseCategories)) { %>
<ol class="list-input">
    <li class="field-group">
        <div class="field">
            <label class="ds-input"><%= gettext("Course Category") %><span class="mandatory">*</span></label>
            <div class="course-category-container">
            <% _.each(courseCategories, function(category) { %>
                <label key="<%= category %>">
                    <input class="ds-radio" type="radio" id="course-category" name="course-category" value="<%= category %>"/>
                    <span><%= gettext(category) %></span>
                </label>
            <% }); %>
            </div>
        </div>
    </li>
</ol>
<% } %>

  </script>
  <script type="text/template" id="course-card-image-editor-tpl">
    <div class="xblock-editor">
    <div class="message modal-introduction">
        <div class="form-check">
            <div class="step3-wrapper">
                <div class="course-container">
                    <div class="course-image-preview-container">
                        <label class="ds-input">
                            <span><%= gettext("Course Card Image (Preview)") %><span class="mandatory">*</span></span>
                        </label>
                        <div class="course-image-preview-card">
                            <div class="wrapper-course-image">
                                <img class="course-image" id="course-image" src="" alt="<%= gettext('Course Card Image') %>"/>
                                <div id="course-type" class="course-type"></div>
                                <div id="course-language" class="course-language"></div>
                            </div>

                            <div class="wrapper-course-details">
                                <div class="course-info">
                                    <section>
                                        <h2 id="course-title" class="course-title">
                                        <ds-tooltip role="tooltip" scheme="dark" style="max-width: calc(306px); box-sizing: border-box;"></ds-tooltip>
                                        </h2>
                                    </section>
                                    <span class="info-date-block-container">
                                        <span id="course-start-date" class="info-date-block localized-datetime" data-language="en" data-timezone="" data-datetime="" data-format="shortDate" data-string="{date}">
                                        </span>
                                    </span>
                                    <div class="info-certificate"></div>
                                </div>

                                <section class="sub-info">
                                    <div class="badge">
                                        <i class="far fa-trophy"></i>
                                        <span>0</span>
                                    </div>
                                    <i class="far fa-solid fa-circle"></i>
                                    <div class="duration">
                                        <i class="far fa-clock"></i>
                                        <span>0</span>
                                    </div>
                                </section>

                            </div>
                        </div>
                    </div>

                    <button class="ds-button action action-upload-image" id="upload-course-image">
                        <i class="fa-regular fa-upload"></i>
                        <%= gettext("Upload Course Card Image") %>
                    </button>

                    <div class="upload-file-details">
                        <span><%= gettext("Image dimensions: 400x310px") %></span>
                        <span><%= gettext("Size limit: 10MB") %></span>
                        <span><%= gettext("Format: .jpeg") %></span>
                    </div>
                </div>

                <div id="image-container">
                    <div id="image-toolbar-buttons">
                        <div class="btn-icon" id="file-upload-button">
                            <span><%= gettext("File Upload") %></span>
                        </div>
                        <div class="btn-icon disabled" id="unsplash-button">
                            <span>Unsplash</span>
                        </div>
                    </div>

                    <div id="file-upload-container">
                        <div id="file-upload-box">
                            <ul id="file-list">
                                <div class="file-list-header">
                                    <div class="file-column-header preview-header"><%= gettext("Preview") %></div>
                                    <div class="file-column-header type-header"><%= gettext("Type of file") %></div>
                                    <div class="file-column-header date-header"><%= gettext("Date") %></div>
                                </div>
                            </ul>
                        </div>
                    </div>

                    <div id="unsplash-container" class="hide">
                        <navbar class="toolbar">
                            <div id="search-container">
                                <label class="ds-input">
                                    <span class="icon">
                                        <i class="far fa-magnifying-glass"></i>
                                    </span>
                                    <input type="text" id="search-query" placeholder="<%= gettext('Type your search term…') %>">
                                </label>
                            </div>
                        </navbar>
                        <hr class="ds-divider">
                        <div id="unsplash-box">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-section"></div>
</div>

  </script>
  <script type="text/template" id="upload-dialog-tpl">
    <form class="upload-dialog" method="POST" action="<%- url %>" enctype="multipart/form-data">
        <p id="dialog-assetupload-description" class="message"><%- message %></p>
        <input id="file-upload-instructor" type="file" name="file" <% if(error && error.attributes && error.attributes.selectedFile) {%>class="error"<% } %> />

    <div class="browser-file-wrapper">
        <label class="browse" for="file-upload-instructor"><i class="far fa-file-upload"></i>Browse</label>
        <span></span>
    </div>
        <div class="status-upload">

            <% if(uploading) { %>
            <div class="wrapper-progress">
                <% if (uploadedBytes && totalBytes) { %>
                <progress value="<%- uploadedBytes %>" max="<%- totalBytes %>"><%- uploadedBytes/totalBytes*100 %>%</progress>
                <% } else { %>
                <progress></progress>
                <% } %>
            </div>
            <% } %>

            <% if(error) {%>
            <div id="upload_error" class="message message-status error is-shown" name="upload_error">
                <p><%- error.message %></p>
            </div>
            <% } %>

            <% if(finished) { %>
            <div id="upload_confirm" class="message message-status confirm success is-shown" name="upload_confirm">
                <p><%- gettext("File upload succeeded") %></p>
            </div>
            <% } %>

        </div>
    </div>
</form>

  </script>
  <script type="text/template" id="basic-modal-tpl">
    <div class="wrapper wrapper-modal-window wrapper-modal-window-<%- name %>"
     aria-labelledby="modal-window-title"
     role="dialog">
    <div class="modal-window-overlay"></div>
    <div class="modal-window <%- viewSpecificClasses %> modal-<%- size %> modal-type-<%- type %>" tabindex="-1" aria-labelledby="modal-window-title">
        <div class="<%- name %>-modal">
            <div class="modal-header">
                <% if (typeof(displayReturnIcon)=='boolean'?displayReturnIcon:false) { %>
                <span class="splinter"></span>
                <% } %>
                <h2 id="modal-window-title" class="title modal-window-title">
                    <%- title %>
                    <% if (modalSRTitle) { %>
                        <span class="sr modal-sr-title">
                            <%- modalSRTitle %>
                        </span>
                    <% } %>
                </h2>

                <% if (typeof(stickActionButtonsToTop)=='boolean'?stickActionButtonsToTop:false) { %>
                    <div class="modal-actions">
                        <h3 class="sr"><%- gettext("Actions") %></h3>
                        <ul></ul>
                    </div>
                <% } %>
                <% if (typeof(displayCloseButton)=='boolean'?displayCloseButton:false) { %>
                <span class="icon-close"><i class="far fa-times"></i></span>
                <% } %>

            </div>
            <% if (showEditorModeButtons) { %>
            <div class="modal-tabs modal-tab-modes">
                <ul class="editor-modes action-list action-modes settings-tabs-header">
                </ul>
            </div>
            <% } %>
            <div class="modal-content">
            </div>
            <% if (typeof(stickActionButtonsToTop)=='boolean'?!stickActionButtonsToTop:true) { %>
            <div class="modal-actions">
                <h3 class="sr"><%- gettext("Actions") %></h3>
                <ul></ul>
            </div>
            <% } %>
        </div>
    </div>
</div>

  </script>
  <script type="text/template" id="modal-button-tpl">
    <li class="action-item">
    <a href="#" class="button <%- isPrimary ? 'action-primary' : '' %> action-<%- type %>"><%- name %></a>
</li>

  </script>
  <script type="text/template" id="course-review-settings-modal-tabs-tpl">
    <ul class="ds-tabs ds-tabs--bottom">
    <% _.each(tabs, function(tab) { %>
    <li data-id="<%- tab.id %>" data-tab="<%- tab.name %>" class="ds-tab settings-tab-button">
        <%- tab.displayName %>
    </li>
    <% }); %>
</ul>
<% _.each(tabs, function(tab) { %>
<div class='settings-tab <%- tab.name %>'></div>
<% }); %>
  </script>
  <script type="text/template" id="course-review-settings-modal-tpl">
    <div class="xblock-editor" data-locator="<%= xblockInfo.get('id') %>" data-course-key="<%= xblockInfo.get('courseKey') %>">
    <div class="message modal-introduction">
        <p><%- introductionMessage %></p>
    </div>
    <div class="modal-section"></div>
</div>

  </script>



