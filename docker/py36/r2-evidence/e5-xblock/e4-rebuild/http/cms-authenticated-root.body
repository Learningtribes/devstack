<div class="wrapper-editing "></div>
<div class="wrapper-mast wrapper">
  <header class="mast has-actions">
    <h1 class="page-header">Studio Home</h1>
    <div class="overview-text">Overview</div>
  </header>
</div>

<div class="wrapper-content wrapper">
  <section class="content">
    <article class="content-primary" role="main">

      <ul id="course-index-tabs">
      </ul>

      <div class="courses courses-tab active">

        <div class="wrapper-create-element wrapper-create-course">
          <form class="form-create create-course course-info" id="create-course-form" name="create-course-form">
            <div class="wrap-error">
              <div id="course_creation_error" name="course_creation_error" class="message message-status message-status error" role="alert">
              <p>Please correct the highlighted fields below.</p>
              </div>
            </div>

            <div class="wrapper-form">
              <h3 class="title">Create a New Course</h3>
              <fieldset>
                <legend class="sr">Required Information to Create a New Course</legend>

                <ol class="list-input">
                  <li class="field text required" id="field-course-name">
                    <label for="new-course-name">Course Name</label>
                    <input class="new-course-name" id="new-course-name" type="text" name="new-course-name" required placeholder="Enter your course name" aria-describedby="tip-new-course-name tip-error-new-course-name" />
                  </li>

                  <li class="field text required" id="field-course-privileges">

                    <label for="new-course-privileges">Privilege Flag(s)</label>
                    <ds-dropdown class="new-course-privileges-dropdown"
                                 placeholder="Select one or multiple Privilege Flags"
                                 multiple
                                 searchable
                    >
                      <label key="1">
                          <input type="checkbox" value="1" class="ds-checkbox"/>
                          <span>Privilege A</span>
                      </label>
                      <label key="2">
                          <input type="checkbox" value="2" class="ds-checkbox"/>
                          <span>Privilege B</span>
                      </label>
                      <label key="3">
                          <input type="checkbox" value="3" class="ds-checkbox"/>
                          <span>Privilege C</span>
                      </label>
                      <label key="4">
                          <input type="checkbox" value="4" class="ds-checkbox"/>
                          <span>Privilege D</span>
                      </label>
                      <label key="5">
                          <input type="checkbox" value="5" class="ds-checkbox"/>
                          <span>Privilege E</span>
                      </label>
                      <label key="6">
                          <input type="checkbox" value="6" class="ds-checkbox"/>
                          <span>Privilege F</span>
                      </label>
                      <label key="7">
                          <input type="checkbox" value="7" class="ds-checkbox"/>
                          <span>Privilege G</span>
                      </label>
                      <label key="8">
                          <input type="checkbox" value="8" class="ds-checkbox"/>
                          <span>Privilege H</span>
                      </label>
                      <label key="9">
                          <input type="checkbox" value="9" class="ds-checkbox"/>
                          <span>Privilege I</span>
                      </label>
                      <label key="10">
                          <input type="checkbox" value="10" class="ds-checkbox"/>
                          <span>Privilege J</span>
                      </label>
                      <label key="11">
                          <input type="checkbox" value="11" class="ds-checkbox"/>
                          <span>Privilege K</span>
                      </label>
                      <label key="12">
                          <input type="checkbox" value="12" class="ds-checkbox"/>
                          <span>Privilege L</span>
                      </label>
                      <label key="13">
                          <input type="checkbox" value="13" class="ds-checkbox"/>
                          <span>Privilege M</span>
                      </label>
                    </ds-dropdown>
                    <input class="hidden" id="new-course-privileges" type="text" name="new-course-privileges" placeholder="" aria-describedby="tip-new-course-privileges tip-error-new-course-privileges" />
                    <span class="tip_box" id="tip-new-course-privileges">Allow content editors associated with these privilege flags to view and edit the course.</span>

                    <div id="selected-course-privilege-flags" class="selected-course-privilege-flags">
                    </div>

                  </li>

                  <li class="field text required" id="field-course-number">
                    <label for="new-course-number">Course Number</label>
                    <input class="new-course-number" id="new-course-number" type="text" name="new-course-number" required placeholder="Enter your course number" aria-describedby="tip-new-course-number tip-error-new-course-number" />
                    <span class="tip_box" id="tip-new-course-number">The unique number that identifies your course within your organization. Note: This is part of your course URL, so no spaces or special characters are allowed and it cannot be changed.</span>
                  </li>

                  <li class="field text required" id="field-course-run">
                    <label for="new-course-run">Course Run</label>
                    <input class="new-course-run" id="new-course-run" type="text" name="new-course-run" required placeholder="Enter your course run date" aria-describedby="tip-new-course-run tip-error-new-course-run" />
                    <span class="tip_box" id="tip-new-course-run">The term in which your course will run. Note: This is part of your course URL, so no spaces or special characters are allowed and it cannot be changed.</span>
                  </li>
                </ol>

              </fieldset>
            </div>

            <div class="actions">
              <input type="hidden" value="False" class="allow-unicode-course-id" />
              <input type="submit" value="Create" class="action action-primary new-course-save" />
              <input type="button" value="Cancel" class="action action-secondary action-cancel new-course-cancel" />
            </div>
          </form>
        </div>

        <div id="non-courses-view" class="items-query-list hide">
          <div class="welcome-view">
              <div class="description">
                  <h3>Welcome to the Studio</h3>
                  <p>We&#39;re thrilled to have you here!</p>
                  <p>To kick things off, you can start building your very first piece of content. Simply click the &#34;+&#34; icon or the button below to begin.</p>
                  <p>Let&#39;s create something amazing together!</p>
                  <input id="btn_create_course" type="button" value="Create a Course">
              </div>
              <img src="/static/studio/images/studio-illustration.jpg"/>
          </div>
        </div>

        <div id="courses-list" class="items-query-list hide">
          <section class="find-courses">
          <section class="courses-container">
            <section class="search-form">
              <div id="discovery-form" role="search" aria-label="course" class="wrapper-search-context">
                <form class="wrapper-search-input">
                  <label for="discovery-input" class="sr">Search for a course</label>
                  <input id="discovery-input" class="discovery-input" placeholder="Search" type="text" title="Course research"/>
                  <button type="submit" class="button postfix discovery-submit" title="Search">
                    <span class="icon fa fa-search" aria-hidden="true"></span>

                  </button>
                  <div aria-live="polite" aria-relevant="all">
                      <div id="loading-indicator" class="loading-spinner ">
                        <span class="icon fa fa-spinner fa-spin" aria-hidden="true"></span>
                        <span class="sr">Loading</span>
                      </div>
                  </div>
                </form>
              </div>

              <aside aria-label="Refine Your Search" class="search-facets phone-menu">
                <section class="search-facets-lists"></section>
                <!--Reset-->
                <button id="clear-all-filters" class="clear-filters flt-right discovery-button" title="Reset filters">
                    <i class="fa-regular fa-filter-circle-xmark icon"></i>
                </button>
              </aside>

              <div id="filter-bar" class="filters hide-phone is-collapsed"></div>

              <!--<div id="discovery-message" class="search-status-label"></div>-->
              <div class="search-status-label">
                <div class="container">
                  <div class="label">
                    <span id="discovery-message" ></span>
                  </div>
                  <div>
                    <span id="id_show_archived_switcher">
                        <span class="switcher"></span>
                        <input type="checkbox" id="show-archived-content" class="hidden" />
                        <span class="switcher_text">Show Archived Content</span>
                    </span>
                  </div>
                </div>
                <div>
                  <button id="export_courses_list" class="ds-button ds-button--neutral">
                    <i class="fa-regular fa-arrow-down-to-bracket" aria-hidden="true"></i>Export as CSV
                  </button>
                </div>
              </div>
              <div id="export-status-message" class="export-status hide"></div>
            </section>
          </section>
        </section>

          <div id="discovery-message" class="search-status-label"></div>

          <div class="list-wrapper">
            <div class="title-bar-container">
              <div class="listing-header">
                <h3 class="courses_title sortable" data-sort_by="+display_name">
                  Course Title
                  <i class="fa fa-long-arrow-up" aria-hidden="true"></i>
                </h3>
                <h3 class="course_creator sortable" data-sort_by="+creator">
                  Creator
                  <i class="fa fa-long-arrow-up hidden" aria-hidden="true"></i>
                </h3>
                <h3 class="course_status sortable" data-sort_by="+course_status">
                  Status
                  <i class="fa fa-long-arrow-up hidden" aria-hidden="true"></i>
                </h3>
                <h3 class="course_created sortable" data-sort_by="+created">
                  Date of Creation
                  <i class="fa fa-long-arrow-up hidden" aria-hidden="true"></i>
                </h3>
                <h3 class="course_modified sortable" data-sort_by="+modified">
                  Last Modification
                  <i class="fa fa-long-arrow-up hidden" aria-hidden="true"></i>
                </h3>
                <h3 class="course_pin"></h3>
              </div>
            </div>
            <ul class="course-listing"></ul>
          </div>
        </div>
      </div>

      <div class="paths paths-tab"></div>

      <div class="libraries react-library-listing libraries-tab ">
      </div>
      <script type="text/javascript">
        setTimeout(function() {
          CourseOrLibraryListingFactory({
            selector: 'div.libraries-tab',
            props: {"linkClass": "library-link", "idBase": "library", "is_program_enabled": true, "libraries_enabled": true, "allow_unicode_course_id": false, "org": "edX", "language_code": "en"}
          })
        }, 500);
      </script>

    </article>
    <aside class="content-supplementary" role="complementary">
      <div class="bit">
        <h3 class="title title-3">New to Studio?</h3>
        <p>Click Help in the upper-right corner to get more information about the Studio page you are viewing. You can also use the links at the bottom of the page to access our continually updated documentation and other Studio resources.</p>

        <ol class="list-actions">
          <li class="action-item">

            <a href="http://edx.readthedocs.io/projects/open-edx-building-and-running-a-course/en/open-release-hawthorn.master/getting_started/CA_get_started_Studio.html" target="_blank">Getting Started with Studio</a>
          </li>
        </ol>
      </div>
    </aside>
  </section>


</div>

