<div class="login-register">
  <section class="form-wrapper">
    <aside>
      <figure>
        <img src='/static/studio/hawthorn/images/login-illustration.jpg' />
      </figure>
    </aside>

    <article role="main">
      <div class="article-inner-wrapper">
      <figure class="welcome-text">
        <a class="brand-link" href="/"><img src="/static/studio/hawthorn/images/studio-logo.png"></a>
        <figcaption>Welcome to your training platform, log in to find your training space!</figcaption>
      </figure>

      <form id="login_form" method="post" action="login_post" onsubmit="return false;">
        <input type="hidden" name="csrfmiddlewaretoken" value="zKmPQMcaddkcCBHX4X7BQUEjYmoGpIM1wdvkfU1KjJJa4u4ryGXBAe8w2FmnZSwS" />

        <div class="form-field">
          <label class="ds-input">
            E-mail
            <input id="email" type="text" name="email" autocomplete="off" required />
          </label>
        </div>

        <div class="form-field">
          <label class="ds-input">
            Password
            <input id="password" type="password" name="password" required />
          </label>

          <a href="//edx.devstack.lms:18000/login#forgot-password-modal" class="ds-link btn">Forgot password?</a>
        </div>

        <button type="submit" id="submit" name="submit" class="action ds-button">Sign In to Studio</button>

        <!-- no honor code for CMS, but need it because we're using the lms student object -->
        <input name="honor_code" type="checkbox" value="true" checked="true" hidden="true">

      </form>
      </div>
    </article>
    <div class="logo-motto-and-toggle-form">
    </div>
  </section>
</div>

