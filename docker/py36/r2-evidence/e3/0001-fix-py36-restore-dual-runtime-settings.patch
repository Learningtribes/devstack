diff --git a/openedx/core/djangoapps/plugins/tests/test_plugin_apps.py b/openedx/core/djangoapps/plugins/tests/test_plugin_apps.py
new file mode 100644
index 00000000000..96acea3acc7
--- /dev/null
+++ b/openedx/core/djangoapps/plugins/tests/test_plugin_apps.py
@@ -0,0 +1,49 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import, division, print_function, unicode_literals
+
+from unittest import TestCase
+
+from django.apps import AppConfig
+from mock import patch
+
+from openedx.core.djangoapps.plugins import plugin_apps
+from openedx.core.djangoapps.plugins.constants import ProjectType
+
+
+class PluginConfig(AppConfig):
+    name = 'plugin_pkg'
+    plugin_app = {}
+
+
+class OtherPluginConfig(AppConfig):
+    name = 'other_pkg'
+    plugin_app = {}
+
+
+class NotAPluginConfig(AppConfig):
+    name = 'regular_pkg'
+
+
+@patch('openedx.core.djangoapps.plugins.plugin_apps.registry.get_app_configs')
+class GetAppsTestCase(TestCase):
+    PLUGIN_PATH = '{}.PluginConfig'.format(__name__)
+    OTHER_PATH = '{}.OtherPluginConfig'.format(__name__)
+
+    def test_returns_plugin_app_config_paths(self, mock_get_app_configs):
+        mock_get_app_configs.return_value = [PluginConfig, NotAPluginConfig, OtherPluginConfig]
+
+        self.assertEqual(plugin_apps.get_apps(ProjectType.LMS), [self.PLUGIN_PATH, self.OTHER_PATH])
+        mock_get_app_configs.assert_called_once_with(ProjectType.LMS)
+
+    def test_skips_plugin_listed_by_module_name(self, mock_get_app_configs):
+        mock_get_app_configs.return_value = [PluginConfig, OtherPluginConfig]
+
+        self.assertEqual(
+            plugin_apps.get_apps(ProjectType.CMS, ['django.contrib.auth', 'plugin_pkg']),
+            [self.OTHER_PATH],
+        )
+
+    def test_skips_plugin_listed_by_app_config_path(self, mock_get_app_configs):
+        mock_get_app_configs.return_value = [PluginConfig, OtherPluginConfig]
+
+        self.assertEqual(plugin_apps.get_apps(ProjectType.LMS, [self.OTHER_PATH]), [self.PLUGIN_PATH])
