diff --git a/lms/urls.py b/lms/urls.py
index d6f998f0be5..ab7ebea5195 100644
--- a/lms/urls.py
+++ b/lms/urls.py
@@ -196,12 +196,15 @@ if settings.WIKI_ENABLED:
     from course_wiki import views as course_wiki_views
     from django_notify.urls import get_pattern as notify_pattern
 
+    # django-wiki v0.0.18 (Python 2.7) returns (patterns, app_name, namespace) and
+    # accepts a namespace argument; the Python 3 pin returns (patterns, app_name) only.
+    wiki_url_patterns, wiki_app_name = wiki_pattern()[:2]
+
     urlpatterns += [
         # First we include views from course_wiki that we use to override the default views.
         # They come first in the urlpatterns so they get resolved first
         url('^wiki/create-root/$', course_wiki_views.root_create, name='root_create'),
-        # get_pattern() returns (patterns, app_name, namespace). Django 1.11 include() accepts that 3-tuple.
-        url(r'^wiki/', include(wiki_pattern())),
+        url(r'^wiki/', include((wiki_url_patterns, wiki_app_name))),
         url(r'^notify/', include(notify_pattern())),
 
         # These urls are for viewing the wiki in the context of a course. They should
@@ -209,7 +212,7 @@ if settings.WIKI_ENABLED:
         url(r'^courses/{}/course_wiki/?$'.format(settings.COURSE_ID_PATTERN),
             course_wiki_views.course_wiki_redirect, name='course_wiki'),
         url(r'^courses/{}/wiki/'.format(settings.COURSE_KEY_REGEX),
-            include(wiki_pattern(app_name='course_wiki_do_not_reverse', namespace='course_wiki_do_not_reverse'))),
+            include((wiki_url_patterns, 'course_wiki_do_not_reverse'), namespace='course_wiki_do_not_reverse')),
     ]
 
 urlpatterns += [
diff --git a/openedx/core/djangoapps/plugins/plugin_apps.py b/openedx/core/djangoapps/plugins/plugin_apps.py
index f1edc0c1aa9..08cabfddd22 100644
--- a/openedx/core/djangoapps/plugins/plugin_apps.py
+++ b/openedx/core/djangoapps/plugins/plugin_apps.py
@@ -5,18 +5,27 @@ from . import constants, registry
 log = getLogger(__name__)
 
 
-def get_apps(project_type):
+def get_apps(project_type, installed_apps=()):
     """
     Returns a list of all registered Plugin Apps, expected to be added to
     the INSTALLED_APPS list for the given project_type.
+
+    Plugins already present in installed_apps, by app module name or by
+    AppConfig path, are skipped. A package that is listed statically and also
+    ships a plugin entry point (edx-proctoring 1.5+ on the Python 3 lock, but
+    not the Python 2.7 fork) would otherwise be installed twice.
     """
-    plugin_apps = [
-        u'{module_name}.{class_name}'.format(
+    plugin_apps = []
+    for app_config in registry.get_app_configs(project_type):
+        if getattr(app_config, constants.PLUGIN_APP_CLASS_ATTRIBUTE_NAME, None) is None:
+            continue
+        app_path = u'{module_name}.{class_name}'.format(
             module_name=app_config.__module__,
             class_name=app_config.__name__,
         )
-        for app_config in registry.get_app_configs(project_type)
-        if getattr(app_config, constants.PLUGIN_APP_CLASS_ATTRIBUTE_NAME, None) is not None
-    ]
+        if app_config.name in installed_apps or app_path in installed_apps:
+            log.debug(u'Plugin Apps: %s is already installed', app_path)
+            continue
+        plugin_apps.append(app_path)
     log.debug(u'Plugin Apps: Found %s', plugin_apps)
     return plugin_apps
