 lms/envs/common.py                            |  9 +++-
 lms/urls.py                                   |  9 ++--
 .../core/djangoapps/plugins/plugin_apps.py    | 21 +++++---
 .../core/djangoapps/plugins/tests/__init__.py |  0
 .../plugins/tests/test_plugin_apps.py         | 49 +++++++++++++++++++
 6 files changed, 87 insertions(+), 11 deletions(-)
 create mode 100644 openedx/core/djangoapps/plugins/tests/__init__.py
