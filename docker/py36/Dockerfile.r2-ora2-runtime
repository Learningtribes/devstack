# R2-preview E6 ORA2 runtime: the edx-submissions Python 3 delta of the R1
# ORA2 gate (Dockerfile.p1b-ora2-runtime; R1 C2 folds the same patch into its
# runtime) on the R2 runtime. The R2 lock already installs ORA2 d3f24a9c, so
# unlike R1 this layer only verifies it.
# Build: docker build -f Dockerfile.r2-ora2-runtime -t ltdps/edxapp:py36-r2-ora2-20261010 .
#   with ltdps/edxapp:py36-r2-20261009 = sha256:f02cf5e79316...
FROM ltdps/edxapp:py36-r2-20261009

LABEL description="Open edX Hawthorn Python 3.6 R2-preview ORA2 runtime"
LABEL base_runtime="ltdps/edxapp:py36-r2-20261009 sha256:f02cf5e79316295694dff8e5248b8704fcd1866fb8b651bef9384c7b395aec37"
LABEL ora2_source_commit="d3f24a9c539528e960c8dcc9aef200cea0c49baf"
LABEL edx_submissions_patch="upstream-equivalent-40cb956+497794b sha256:00b289b42748b93e314fbb8cf90117778ceadac4789f7ec234fc9ef554b31acf"

COPY edx-submissions-2.1.1-py3.patch /opt/py36-r2/edx-submissions-2.1.1-py3.patch

RUN echo "00b289b42748b93e314fbb8cf90117778ceadac4789f7ec234fc9ef554b31acf  /opt/py36-r2/edx-submissions-2.1.1-py3.patch" | sha256sum -c - \
    && python -c "import glob, json, pkg_resources; dist = pkg_resources.get_distribution('ora2'); paths = glob.glob(dist.location + '/ora2-*.dist-info/direct_url.json'); assert dist.version == '2.1.17'; assert len(paths) == 1; direct_url = json.load(open(paths[0])); assert direct_url['vcs_info']['commit_id'] == 'd3f24a9c539528e960c8dcc9aef200cea0c49baf'; print('ORA2 source OK', direct_url)" \
    && cd /usr/local/lib/python3.6/site-packages \
    && echo "7eed5f98f9db1ef05de9ad5706a6abc5f8c75134a131dcedd8438f1116b0c3d4  submissions/api.py" | sha256sum -c - \
    && echo "484e83e31be3a44b084e8c2a976baf48620129ddd18467f805a7280e34fb1c75  submissions/models.py" | sha256sum -c - \
    && git apply --unidiff-zero --check /opt/py36-r2/edx-submissions-2.1.1-py3.patch \
    && git apply --unidiff-zero /opt/py36-r2/edx-submissions-2.1.1-py3.patch \
    && echo "a30b76f9f7676c73b57f8a696c6eb1fc101ae4a6cabf80680cc8f1e5380dd319  submissions/api.py" | sha256sum -c - \
    && echo "0b89c4191af3c9aaeaf41376c3dd44ad194841e95adee964360eb1a79cb68de3  submissions/models.py" | sha256sum -c - \
    && cd / \
    && python -m compileall -q \
        /usr/local/lib/python3.6/site-packages/submissions/api.py \
        /usr/local/lib/python3.6/site-packages/submissions/models.py \
    && python -c "import pkg_resources; assert pkg_resources.get_distribution('edx-submissions').version == '2.1.1'" \
    && ! grep -E 'basestring|unicode\(' \
        /usr/local/lib/python3.6/site-packages/submissions/api.py \
        /usr/local/lib/python3.6/site-packages/submissions/models.py \
    && pip check
