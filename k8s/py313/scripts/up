#!/usr/bin/env bash
# Local OrbStack bring-up: guards -> namespace -> secrets -> backing services -> Elasticsearch role/user -> configuration ->
# db-init Job -> application overlay -> rollouts. Idempotent: every step can be rerun; a completed db-init is not run again unless
# FORCE_DB_INIT=1 (the database is new; no wipe exists, by design). APP_OVERLAY selects another application overlay, e.g.
# overlays/orbstack-local-all-workers (it renders the same namespace and base).
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
require_context
require_image
command -v docker >/dev/null && command -v openssl >/dev/null || die 'docker and openssl are required'
APP_OVERLAY=${APP_OVERLAY:-$OVERLAY}
[ -f "$APP_OVERLAY/kustomization.yaml" ] || die "no kustomization in $APP_OVERLAY"
start=$SECONDS

step "Namespace $NS"
kc apply -f "$OVERLAY/namespace.yaml" >/dev/null
require_owned_namespace
# db-init uses the ServiceAccount of the base before the application overlay exists.
k apply -f "$K8S_DIR/base/serviceaccount.yaml" >/dev/null

step 'Secrets'
"$SCRIPTS_DIR/gen-local-secrets"

step 'Backing services'
k apply -k "$OVERLAY/backing" >/dev/null
for kind_name in statefulset/mysql statefulset/mongodb statefulset/elasticsearch statefulset/rabbitmq deployment/memcached; do
  wait_rollout "$kind_name" 900s
done

step 'Elasticsearch role and user'
"$SCRIPTS_DIR/setup-elasticsearch"

step 'Configuration'
"$SCRIPTS_DIR/gen-local-config"

step 'db-init Job'
state=$(k get job db-init -o jsonpath='{.status.conditions[?(@.type=="Complete")].status}' 2>/dev/null || true)
if [ "$state" = True ] && [ "${FORCE_DB_INIT:-0}" != 1 ]; then
  note 'db-init already completed (FORCE_DB_INIT=1 reruns it)'
else
  k delete job db-init --ignore-not-found --wait=true >/dev/null
  k apply -k "$OVERLAY/jobs" >/dev/null
  # Wait for either outcome; a failed Job must not hide behind a timeout.
  deadline=$((SECONDS + 1800))
  while :; do
    ok=$(k get job db-init -o jsonpath='{.status.succeeded}' 2>/dev/null || true)
    bad=$(k get job db-init -o jsonpath='{.status.failed}' 2>/dev/null || true)
    [ "${ok:-0}" -ge 1 ] 2>/dev/null && break
    if [ "${bad:-0}" -ge 1 ] 2>/dev/null; then
      k logs job/db-init --tail=60 >&2 || true
      die 'db-init failed (logs above); fix the cause, then rerun scripts/up (the Job is recreated)'
    fi
    [ "$SECONDS" -lt "$deadline" ] || die 'db-init did not finish in 30 minutes'
    sleep 10
  done
  note 'db-init completed'
  k logs job/db-init --tail=12 | sed 's/^/   | /'
fi

step "Application overlay ${APP_OVERLAY#"$K8S_DIR"/}"
kc apply -k "$APP_OVERLAY" >/dev/null
for name in $(k get deployment -o jsonpath='{range .items[?(@.spec.replicas>0)]}{.metadata.name}{"\n"}{end}'); do
  wait_rollout "deployment/$name" 1200s
done

step 'Summary'
k get pods -o wide --no-headers | awk '{printf "   %-48s %-7s %-10s restarts=%s\n", $1, $2, $3, $4}'
printf '   elapsed: %ds\n   next: scripts/smoke   (port-forward svc/lms 18000:8000, svc/cms 18010:8010)\n' $((SECONDS - start))
