#!/usr/bin/env bash
# Installs the cluster side of the Traefik mode. Cluster-level objects (the complete list, see README "Blast radius"):
#   Namespace traefik, the ten CRDs of the traefik.io group, ClusterRole/ClusterRoleBinding traefik-py313-local,
#   ConfigMap kube-system/coredns-custom (+ a CoreDNS rollout restart). Run by scripts/up when INGRESS=traefik, after the namespace guard.
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
require_context
require_image
require_owned_namespace

# A same-named object that this feature did not create is never adopted.
owned_or_absent() { # owned_or_absent KIND NAME [NAMESPACE]
  local label
  if ! kc get "$1" "$2" ${3:+-n "$3"} >/dev/null 2>&1; then return 0; fi
  label=$(kc get "$1" "$2" ${3:+-n "$3"} -o jsonpath="{.metadata.labels.py313\\.learningtribes\\.com/feature}")
  [ "$label" = traefik-local ] || die "$1/$2 exists and was not created by this feature (label $FEATURE_LABEL missing): refusing to adopt it"
}
step 'Pre-flight: nothing foreign is adopted'
owned_or_absent namespace "$TNS"
owned_or_absent clusterrole traefik-py313-local
owned_or_absent clusterrolebinding traefik-py313-local
for crd in $(sed -n 's/^  name: \(.*\.traefik\.io\)$/\1/p' "$TRAEFIK_DIR/crds/crds.yaml"); do owned_or_absent crd "$crd"; done
owned_or_absent configmap coredns-custom kube-system
note 'ok'

step "Namespace $TNS"
kc apply -f "$TRAEFIK_DIR/namespace.yaml" >/dev/null
note "applied $TNS"

step 'Local CA, certificate, Secrets and CA bundle'
"$SCRIPTS_DIR/gen-local-tls"

step 'Traefik CRDs (traefik.io, all ten: the CRD provider watches every kind)'
kc apply --server-side --force-conflicts --field-manager=py313-local -k "$TRAEFIK_DIR/crds" >/dev/null
kc wait --for=condition=Established --selector "$FEATURE_LABEL" crd --timeout=60s >/dev/null
note 'established'

step 'Traefik'
kc apply -k "$TRAEFIK_DIR" >/dev/null
kt rollout status deployment/traefik --timeout=300s >/dev/null && note 'ready: deployment/traefik' || {
  kt describe deployment/traefik | tail -n 20 >&2; kt logs deploy/traefik --tail=30 >&2 || true; die 'traefik did not become ready'; }

step 'CoreDNS: site names resolve to the Traefik Service inside the cluster'
current=$(kc -n kube-system get configmap coredns-custom -o jsonpath='{.data.local-prod\.override}' 2>/dev/null || true)
wanted=$(sed -n '/^  local-prod.override: |$/,$p' "$TRAEFIK_DIR/coredns-custom.yaml" | tail -n +2 | sed 's/^    //')
if [ "$current" = "$wanted" ] && [ -n "$current" ]; then
  note 'coredns-custom is up to date: no restart'
else
  kc apply -f "$TRAEFIK_DIR/coredns-custom.yaml" >/dev/null
  kc -n kube-system rollout restart deployment/coredns >/dev/null
  kc -n kube-system rollout status deployment/coredns --timeout=120s >/dev/null
  note 'applied kube-system/coredns-custom and restarted coredns'
fi

step 'LoadBalancer'
for _ in $(seq 1 30); do
  address=$(kt get service traefik -o jsonpath='{.status.loadBalancer.ingress[0].ip}{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
  [ -n "$address" ] && break; sleep 2
done
note "service traefik: ClusterIP $(kt get service traefik -o jsonpath='{.spec.clusterIP}'), load balancer address '${address:-pending}'"
