#!/usr/bin/env bash
# Creates k8s/py313/.local/ (mode 700) with random credentials and the Secret backing-credentials. Existing files are kept, so a
# rerun never rotates a password that a database volume was already initialised with. Nothing is printed or written to a tracked path.
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
require_context
command -v openssl >/dev/null || die 'openssl is required'
ensure_local_dir

# Database name: Platform database_guard.py only lets the bring-up scripts touch py313_startup_* / py313_rebuild_* databases.
put() { # put NAME VALUE: write only when missing
  [ -s "$(secret_file "$1")" ] || { printf '%s' "$2" > "$(secret_file "$1")"; chmod 600 "$(secret_file "$1")"; note "generated $1"; }
}
put mysql-database py313_startup_local
put mysql-user edxapp
put mongo-user py313_mongo_root
put rabbitmq-user py313
for name in mysql-root-password mysql-password mongo-password rabbitmq-password elastic-password \
            bringup-xqueue-password es-app-password; do
  [ -s "$(secret_file "$name")" ] || put "$name" "$(openssl rand -hex 24)"
done
[ -s "$(secret_file bringup-secret-key)" ] || put bringup-secret-key "$(openssl rand -hex 32)"
# The generator copies this key into lms.auth.json (JWT_PRIVATE_SIGNING_KEY); staging creates it the same way.
if [ ! -s "$LOCAL_DIR/jwt-private.pem" ]; then
  openssl genrsa -out "$LOCAL_DIR/jwt-private.pem" 2048 2>/dev/null
  chmod 600 "$LOCAL_DIR/jwt-private.pem"; note 'generated jwt-private.pem'
fi

step "Secret backing-credentials in namespace $NS"
kc get namespace "$NS" >/dev/null 2>&1 || die "namespace $NS does not exist (scripts/up creates it)"
keys=(mysql-root-password mysql-database mysql-user mysql-password mongo-user mongo-password rabbitmq-user rabbitmq-password
      elastic-password bringup-secret-key bringup-xqueue-password)
require_secret_files "${keys[@]}"
args=()
for key in "${keys[@]}"; do args+=("--from-file=$key=$(secret_file "$key")"); done
k create secret generic backing-credentials "${args[@]}" --dry-run=client -o yaml | apply_secret_stream
note "keys: ${keys[*]}"
